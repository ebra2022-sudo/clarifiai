ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# Clarity: one token for all projects, or a per-project map (map wins)
CLARITY_API_TOKEN=
CLARITY_TOKENS_JSON={"yourProjectId":"yourClarityApiToken"}
DATABASE_PATH=clarity_ai.db
CACHE_TTL_SECONDS=3600
SNAPSHOT_HOUR_UTC=23
# Google Play subscription verification
PLAY_PACKAGE_NAME=com.clarifiai.app
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/play-service-account.json
# NEVER enable in production: lets a client self-assign a tier via X-Dev-Tier
DEV_ALLOW_TIER_OVERRIDE=false
