ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# Users connect their own Clarity projects in the app; tokens are stored encrypted with this key.
# Generate once:  .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it after tokens are stored, or they can't be decrypted.
TOKEN_ENCRYPTION_KEY=
# Optional, operator-configured projects: one token for all projects, or a per-project map (map wins)
CLARITY_API_TOKEN=
CLARITY_TOKENS_JSON={}
DATABASE_PATH=clarity_ai.db
# Hosted: a Postgres URL (e.g. Neon). When set it is used instead of DATABASE_PATH.
DATABASE_URL=
CACHE_TTL_SECONDS=3600
SNAPSHOT_HOUR_UTC=23
# Google Play subscription verification
PLAY_PACKAGE_NAME=com.clarifiai.app
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/play-service-account.json
# NEVER enable in production: lets a client self-assign a tier via X-Dev-Tier
DEV_ALLOW_TIER_OVERRIDE=false
